# ps5-shellui-lock - Native PS5 ELF Daemon Makefile

ifdef PS5_PAYLOAD_SDK
    include $(PS5_PAYLOAD_SDK)/toolchain/prospero.mk
else
    $(error PS5_PAYLOAD_SDK is undefined)
endif

PS5_HOST ?= ps5
PS5_PORT ?= 9021

# Paths
TARGET   := $(PS5_PAYLOAD_SDK)/target
INCLUDES := -Iinclude -I$(TARGET)/include
LIBS     := -L$(TARGET)/lib -lpthread \
            -lSceUserService -lSceSystemService

# Source Files
SRCS := src/main.c \
				src/appdb.c \
				src/config.c \
				src/ps5_util.c \
			  $(TARGET)/src/sqlite3.c
OBJS := $(SRCS:.c=.o)
ELF  := lockshellui.elf

# Compiler Flags
CFLAGS := -Os -Wall -DPS5_PAYLOAD_SDK -ffunction-sections -fdata-sections $(INCLUDES)
LDFLAGS := -Wl,--gc-sections

all: $(ELF)

$(ELF): $(SRCS)
	@echo "Building $(ELF)..."
	$(CC) $(CFLAGS) $(LDFLAGS) -o $(ELF) $(SRCS) $(LIBS)
	@echo "Stripping $(ELF)..."
	$(STRIP) $(ELF)

test: $(ELF)
	$(PS5_DEPLOY) -h $(PS5_HOST) -p $(PS5_PORT) $^

clean:
	rm -f $(ELF) src/*.o $(TARGET)/src/*.o

.PHONY: all clean
